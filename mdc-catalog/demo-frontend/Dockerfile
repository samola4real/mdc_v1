# syntax=docker/dockerfile:1.7

# =============================================================================
# MaaSAI · Frontend
# Multi-stage build producing a minimal Next.js standalone runtime.
# Supports linux/amd64 and linux/arm64 via buildx (factories often run ARM
# edge hardware — Jetson, Raspberry Pi, NUC ARM).
# Final image: ~180 MB (vs ~1.1 GB with full node_modules).
# =============================================================================

ARG NODE_VERSION=20.18.0
ARG ALPINE_VERSION=3.20

# -----------------------------------------------------------------------------
# Stage 1 · deps — install production+dev dependencies needed to compile.
# Cached separately so editing source code does NOT re-run npm install.
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS deps
WORKDIR /app

# libc6-compat is required by some native deps (sharp, swc) on Alpine.
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

# -----------------------------------------------------------------------------
# Stage 2 · builder — compile Next.js with `output: 'standalone'`.
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build

# -----------------------------------------------------------------------------
# Stage 3 · runner — only what the standalone server needs.
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Run as non-root for security.
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 --ingroup nodejs nextjs

# Minimal payload from the builder: the standalone server, static assets, and
# the public folder (icons, runtime config, etc.).
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Tiny tool for HEALTHCHECK (no curl in alpine by default).
RUN apk add --no-cache wget

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=4s --start-period=15s --retries=3 \
    CMD wget --quiet --spider --tries=1 http://127.0.0.1:3000/ || exit 1

# server.js is generated by Next.js standalone output.
CMD ["node", "server.js"]
