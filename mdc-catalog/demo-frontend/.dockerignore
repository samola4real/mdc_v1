# =============================================================================
# Keep the build context small (faster uploads, smaller cache) and avoid
# leaking secrets or dev-only artefacts into the image.
# =============================================================================

# Dependencies & build output
node_modules
.next
out
dist
build

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.swo

# Git
.git
.gitignore
.gitattributes

# CI & infra
.github
.gitlab-ci.yml
.circleci
Makefile
docker-compose*.yml
Dockerfile*
.dockerignore

# Environment & secrets
.env
.env.local
.env.*.local
*.pem

# Tests & coverage
coverage
.nyc_output
__snapshots__

# Misc docs (already documented in repo, no need inside the image)
README.md
LICENSE
*.md
