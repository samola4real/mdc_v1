# MaaSAI MDC environment template
#
# Local development:
#   Copy this file to mdc-catalog/.env and fill local values/secrets there.
#   Never commit mdc-catalog/.env.
#
# Deployed environments (temporary Vercel, future AWS):
#   Supply these same variable names through the platform's environment/
#   secret-management mechanism instead of shipping a .env file.
#
# Do not put Vercel CLI credentials such as VERCEL_OIDC_TOKEN here.
# .env.local remains tool-generated and is ignored by Git.
#
# DJANGO_SETTINGS_MODULE is intentionally not defined here. The Django
# entrypoint/deployment must select the settings module before settings load.

# -----------------------------------------------------------------------------
# Django / application
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=local-dev-only-replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Leave empty to use SQLite locally.
# For managed PostgreSQL, paste the complete PostgreSQL connection URL here.
# Preserve provider-supplied query options such as sslmode=require.
# Django currently uses CONN_MAX_AGE=0 for cloud/serverless portability.
DATABASE_URL=

# -----------------------------------------------------------------------------
# MDC feature/safety flags
# -----------------------------------------------------------------------------
MDC_DEMO_API_ENABLED=True
# Keep provider publication disabled until the M7 lifecycle/security gates pass.
MDC_PROVIDER_PUBLICATION_ENABLED=False
# Interim exposure control only; this is not authentication or authorization.
MDC_PROVIDER_VALIDATION_ENABLED=False

# -----------------------------------------------------------------------------
# RDF / Apache Jena Fuseki
# -----------------------------------------------------------------------------
FUSEKI_BASE_URL=http://localhost:3030
FUSEKI_DATASET=mdc
FUSEKI_QUERY_ENDPOINT=http://localhost:3030/mdc/sparql
FUSEKI_UPDATE_ENDPOINT=http://localhost:3030/mdc/update
# Set only when the H1-H9 runtime should query a remote Fuseki endpoint.
SERVICE_DISCOVERY_FUSEKI_QUERY_ENDPOINT=
FUSEKI_TIMEOUT_SECONDS=5
