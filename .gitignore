# Virtual environments
.venv/
venv/

# Editor and deployment-tool local state
.vscode/
.vercel/

# Local development notes that remain untracked
Chat_MDC_Dev/
MDC_Dev_chat/
new_Phases.md

# Python cache files and test output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local environment and secret files
# Canonical MDC local application configuration is mdc-catalog/.env.
# Ignore it and all environment variants/tool-generated secret files
# such as .env.local, .env.production, etc. Keep only safe examples tracked.
.env
.env.*
!.env.example
!mdc-catalog/.env.example

# Django/local runtime artifacts
db.sqlite3
*.sqlite3
staticfiles/
media/
*.log
mdc-catalog/data/demo/provider_demo_state*.json

# OS and office temp files
.DS_Store
Thumbs.db
~$*.xlsx

# Duplicate local data archives
mdc-catalog/data/curated/*.zip
